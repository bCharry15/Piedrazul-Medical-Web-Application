# Copie este archivo como .env en el servidor y cambie los valores.
# El archivo .env no se sube al repositorio.

# Dominio público del servidor (sin https://)
PIEDRAAZUL_DOMAIN=piedraazul-julian.spaincentral.cloudapp.azure.com

# Contraseñas de MariaDB
MARIADB_ROOT_PASSWORD=cambie-esta-clave-root
MARIADB_PASSWORD=cambie-esta-clave-app

# Contraseña del administrador de Keycloak (realm master)
KEYCLOAK_ADMIN_PASSWORD=cambie-esta-clave-admin
